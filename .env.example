# Retrieval: hashing (fast/offline) or semantic (multilingual embeddings)
DOCUMENT_AI_ENCODER=hashing
DOCUMENT_AI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Optional OpenAI-compatible endpoint for generative answers.
# Without these values, the application uses citation-first extractive answers.
DOCUMENT_AI_BASE_URL=
DOCUMENT_AI_API_KEY=
DOCUMENT_AI_MODEL=

